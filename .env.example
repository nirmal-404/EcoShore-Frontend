# API base URL (must include /api)
VITE_API_URL=https://ecoshore-backend-production.up.railway.app/api

# Optional extra STUN servers (comma-separated)
# VITE_STUN_URLS=stun:stun2.l.google.com:19302,stun:stun3.l.google.com:19302

# TURN relay servers for production WebRTC reliability (comma-separated)
# Example:
# VITE_TURN_URLS=turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional debug logs for realtime signaling/WebRTC
VITE_ENABLE_WEBRTC_DEBUG=false
